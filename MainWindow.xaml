<Window x:Class="Proekt3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Proekt3"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1024"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <!-- TabControl для переключения между разделами -->
        <TabControl>
            <!-- ========== Вкладка "Пациенты" ========== -->
            <TabItem Header="Пациенты" Width="100">
                <Grid>
                    <!-- Разметка: панель кнопок + таблица -->
                    <Grid.RowDefinitions>
                        <!-- Панель кнопок -->
                        <RowDefinition Height="Auto"/>
                        <!-- Таблица -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель кнопок управления пациентами -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="btnAddPatient" Content="Добавить" Style="{StaticResource ButtonStyle}" 
                                Click="BtnAddPatient_Click"/>
                        <Button x:Name="btnEditPatient" Content="Редактировать" Style="{StaticResource ButtonStyle}" 
                                Click="BtnEditPatient_Click"/>
                        <Button x:Name="btnDeletePatient" Content="Удалить" Style="{StaticResource ButtonStyle}" 
                                Click="BtnDeletePatient_Click"/>
                        <Button x:Name="btnRefreshPatients" Content="Обновить" Style="{StaticResource ButtonStyle}" 
                                Click="BtnRefreshPatients_Click"/>
                    </StackPanel>

                    <!-- Таблица пациентов -->
                    <DataGrid x:Name="dgPatients" Grid.Row="1" AutoGenerateColumns="False" 
                              IsReadOnly="True" SelectionMode="Single" 
                              MouseDoubleClick="DgPatients_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="ФИО пациента" Binding="{Binding FullName}" Width="200"/>
                            <DataGridTextColumn Header="Дата рождения" Binding="{Binding BirthDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="120"/>
                            <DataGridTextColumn Header="СНИЛС" Binding="{Binding Snils}" Width="120"/>
                            <DataGridTextColumn Header="Последний визит" Binding="{Binding LastVisit, StringFormat=dd.MM.yyyy}" Width="120"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ========== Вкладка "Услуги" ========== -->
            <TabItem Header="Услуги" Width="100">
                <Grid>
                    <!-- Разметка: панель кнопок + таблица -->
                    <Grid.RowDefinitions>
                        <!-- Панель кнопок -->
                        <RowDefinition Height="Auto"/>
                        <!-- Таблица -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель кнопок управления услугами -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="btnAddService" Content="Добавить" Style="{StaticResource ButtonStyle}" 
                                Click="BtnAddService_Click"/>
                        <Button x:Name="btnEditService" Content="Редактировать" Style="{StaticResource ButtonStyle}" 
                                Click="BtnEditService_Click"/>
                        <Button x:Name="btnDeleteService" Content="Удалить" Style="{StaticResource ButtonStyle}" 
                                Click="BtnDeleteService_Click"/>
                        <Button x:Name="btnRefreshServices" Content="Обновить" Style="{StaticResource ButtonStyle}" 
                                Click="BtnRefreshServices_Click"/>
                    </StackPanel>

                    <!-- Таблица услуг -->
                    <DataGrid x:Name="dgServices" Grid.Row="1" AutoGenerateColumns="False" 
                              IsReadOnly="True" SelectionMode="Single"
                              MouseDoubleClick="DgServices_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Название услуги" Binding="{Binding Name}" Width="250"/>
                            <DataGridTextColumn Header="Стоимость(руб)" Binding="{Binding Cost, StringFormat=C}" Width="120"/>
                            <DataGridTextColumn Header="Продолжительность (мин)" Binding="{Binding Duration}" Width="150"/>
                            <DataGridTextColumn Header="Кабинет" Binding="{Binding Cabinet}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
