<Window x:Class="Proekt3.PatientEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Proekt3"
        mc:Ignorable="d"
        Title="PatientEditDialog" Height="450" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="15">
        <!-- Разметка строк окна -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Сообщение об ошибке -->
            <RowDefinition Height="Auto"/>
            <!-- ФИО -->
            <RowDefinition Height="Auto"/>
            <!-- Дата рождения -->
            <RowDefinition Height="Auto"/>
            <!-- Телефон -->
            <RowDefinition Height="Auto"/>
            <!-- СНИЛС -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопки -->
            <RowDefinition Height="*"/>
            <!-- Отступ -->
        </Grid.RowDefinitions>

        <!-- Область для отображения ошибок валидации -->
        <TextBlock x:Name="txtError" Foreground="{StaticResource ErrorColor}" 
                   HorizontalAlignment="Center" FontSize="12" Margin="0,0,0,10"/>

        <!-- Поле ФИО -->
        <StackPanel Grid.Row="1" Margin="0,5">
            <TextBlock Text="ФИО пациента*" FontWeight="Bold"/>
            <TextBox x:Name="txtFullName" Style="{StaticResource ValidationErrorStyle}"
                     TextChanged="ValidateForm" Height="25"/>
        </StackPanel>

        <!-- Поле даты рождения -->
        <StackPanel Grid.Row="2" Margin="0,5">
            <TextBlock Text="Дата рождения*" FontWeight="Bold"/>
            <DatePicker x:Name="dpBirthDate" SelectedDateChanged="ValidateForm" Height="25"/>
        </StackPanel>

        <!-- Поле телефона -->
        <StackPanel Grid.Row="3" Margin="0,5">
            <TextBlock Text="Телефон*" FontWeight="Bold"/>
            <TextBox x:Name="txtPhone" Style="{StaticResource ValidationErrorStyle}"
                     TextChanged="ValidateForm" Height="25"/>
        </StackPanel>

        <!-- Поле СНИЛС -->
        <StackPanel Grid.Row="4" Margin="0,5">
            <TextBlock Text="СНИЛС* (формат: XXX-XXX-XXX XX)" FontWeight="Bold"/>
            <TextBox x:Name="txtSnils" Style="{StaticResource ValidationErrorStyle}"
                     TextChanged="ValidateForm" Height="25"/>
        </StackPanel>

        <!-- Кнопки Сохранить и Отмена -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15">
            <Button x:Name="btnSave" Content="Сохранить" Width="80" Height="28" 
                    Margin="5" Click="BtnSave_Click" IsEnabled="False"/>
            <Button x:Name="btnCancel" Content="Отмена" Width="80" Height="28" 
                    Margin="5" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
